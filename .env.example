# ==============================================================================
# Make Slide Pro V7.3 - Production Environment Configuration Template
# ==============================================================================

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=generate_a_random_32_character_secret_here_for_production
APP_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///./make_slide_pro.db
# DATABASE_URL=postgresql://msp_user:msp_password@localhost:5432/make_slide_pro_prod

# Redis Task Queue & WebSocket Pub/Sub
REDIS_URL=redis://localhost:6379/0

# File Upload & Safety Guards
MAX_UPLOAD_SIZE_MB=25
MAX_RAW_TEXT_CHARS=500000

# Google Gemini LLM API (Pedagogy & Copilot)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Banking & VietQR Payment Integration
VIETQR_BANK_CODE=970422
VIETQR_ACCOUNT_NUMBER=999988886666
VIETQR_ACCOUNT_NAME=MAKE SLIDE PRO SAAS
SEPAY_WEBHOOK_API_KEY=your_sepay_api_key_if_used

# Object Storage (S3 / MinIO / GCS)
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET_NAME=make-slide-pro-storage
