{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.make-slide-pro/schemas/slide-blueprint.schema.json",
  "title": "Make Slide Pro Slide Blueprint",
  "type": "object",
  "required": ["schema_version", "deck_id", "slides"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "deck_id": { "type": "string", "minLength": 1 },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id", "slide_number", "role", "assertion_title", "primary_claim", "source_atoms", "visual_job"],
        "properties": {
          "slide_id": { "type": "string", "minLength": 1 },
          "slide_number": { "type": "integer", "minimum": 1 },
          "role": { "enum": ["TITLE", "EXECUTIVE_SUMMARY", "CONTEXT", "PROBLEM", "INSIGHT", "STRATEGY", "PILLAR", "ROADMAP", "OPERATING_MODEL", "FINANCIAL", "DATA_STORY", "COMPARISON", "PROCESS", "CASE_STUDY", "DECISION", "ACTION", "APPENDIX", "CLOSING"] },
          "assertion_title": { "type": "string", "minLength": 1 },
          "primary_claim": { "type": "string", "minLength": 1 },
          "source_atoms": { "type": "array", "items": { "type": "string" } },
          "speaker_note_atoms": { "type": "array", "items": { "type": "string" } },
          "appendix_atoms": { "type": "array", "items": { "type": "string" } },
          "primary_evidence": { "type": "array", "items": { "type": "object" } },
          "implication": { "type": ["string", "null"] },
          "visual_job": { "enum": ["SET_CONTEXT", "PROVE_SCALE", "SHOW_TREND", "COMPARE_OPTIONS", "EXPLAIN_CAUSALITY", "SHOW_SYSTEM", "SHOW_SEQUENCE", "SHOW_GEOGRAPHY", "SHOW_BEFORE_AFTER", "HUMANIZE", "EMPHASIZE_DECISION", "SUMMARIZE", "CLOSE"] },
          "visual_anchor": {
            "type": "object",
            "required": ["kind", "asset_or_object_ids"],
            "properties": {
              "kind": { "enum": ["CHART", "TABLE", "PHOTO", "PRODUCT", "ILLUSTRATION", "DIAGRAM", "MAP", "SCREENSHOT", "METRIC", "MIXED"] },
              "asset_or_object_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "caption": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "asset_ids": { "type": "array", "items": { "type": "string" } },
          "chart_ids": { "type": "array", "items": { "type": "string" } },
          "table_ids": { "type": "array", "items": { "type": "string" } },
          "transition": { "type": "string" },
          "motion_beats": { "type": "array", "items": { "type": "object" } },
          "speaker_notes": { "type": "string" },
          "appendix_refs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
