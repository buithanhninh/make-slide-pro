{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.make-slide-pro/schemas/evidence-receipt.schema.json",
  "title": "Make Slide Pro Evidence Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "evidence_name",
    "subject_path",
    "subject_sha256",
    "producer",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PASS", "UNVERIFIED", "BLOCKED"] },
    "evidence_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,}$" },
    "subject_path": { "type": "string", "minLength": 1 },
    "subject_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "producer": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "status"],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "UNVERIFIED", "BLOCKED"] },
          "detail": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "metrics": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": { "status": { "const": "PASS" } },
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "evidence_name": { "const": "visual_assets_verified" } },
        "required": ["evidence_name"]
      },
      "then": {
        "required": ["metadata"],
        "properties": {
          "metadata": { "$ref": "#/$defs/native_visual_binding" }
        }
      }
    }
  ],
  "$defs": {
    "native_visual_binding": {
      "type": "object",
      "required": [
        "native_bindings_verified",
        "native_visual_coverage_report_path",
        "native_visual_coverage_report_sha256",
        "native_visual_coverage_deck_sha256"
      ],
      "properties": {
        "native_bindings_verified": { "const": true },
        "native_visual_coverage_report_path": { "type": "string", "minLength": 1 },
        "native_visual_coverage_report_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "native_visual_coverage_deck_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
