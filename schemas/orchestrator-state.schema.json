{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.make-slide-pro/schemas/orchestrator-state.schema.json",
  "title": "Make Slide Pro Orchestrator State",
  "type": "object",
  "required": ["schema_version", "run_id", "pipeline_version", "state_revision", "status", "active_profile", "source_snapshot_hash", "job_contract_hash", "fingerprints", "capability_binding", "gates"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "state_revision": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["INITIALIZED", "RUNNING", "WAITING_APPROVAL", "PASS", "UNVERIFIED", "BLOCKED", "STALE", "MIGRATION_REQUIRED"] },
    "active_profile": { "enum": ["STATIC_READY_FOR_MOTION", "FINAL_RELEASE_STATIC", "FINAL_RELEASE_MOTION"] },
    "source_snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "job_contract_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fingerprints": { "$ref": "#/$defs/fingerprints" },
    "capability_binding": { "anyOf": [{ "$ref": "#/$defs/capability_binding" }, { "type": "null" }] },
    "gates": { "type": "object", "additionalProperties": { "$ref": "#/$defs/gate_state" } },
    "lease": { "anyOf": [{ "$ref": "#/$defs/lease" }, { "type": "null" }] },
    "last_event_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "next_gate": { "type": ["string", "null"], "pattern": "^G(?:0|[1-9]|1[0-5])_[A-Z0-9_]+$" }
  },
  "$defs": {
    "fingerprints": {
      "type": "object",
      "required": ["skill_sha256", "schema_bundle_sha256", "gate_registry_sha256", "script_fingerprint", "runtime_fingerprint", "office_fingerprint", "font_fingerprint", "artifact_tool_fingerprint"],
      "properties": {
        "skill_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "schema_bundle_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "gate_registry_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "script_fingerprint": { "type": "string", "minLength": 1 },
        "runtime_fingerprint": { "type": "string", "minLength": 1 },
        "office_fingerprint": { "type": "string", "minLength": 1 },
        "font_fingerprint": { "type": "string", "minLength": 1 },
        "artifact_tool_fingerprint": { "type": "string", "minLength": 1 },
        "asr_runtime_fingerprint": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "capability_binding": {
      "type": "object",
      "required": ["path", "sha256", "probe_id", "fingerprint", "ttl_expires_at", "status", "bound_at"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "probe_id": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "ttl_expires_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["PASS", "UNVERIFIED", "BLOCKED"] },
        "bound_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "gate_state": {
      "type": "object",
      "required": ["status", "attempts", "invalidation_keys"],
      "properties": {
        "status": { "enum": ["PENDING", "RUNNING", "PASS", "UNVERIFIED", "BLOCKED", "SKIPPED", "STALE", "QUARANTINED"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "invalidation_keys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "receipt_path": { "type": ["string", "null"], "minLength": 1 },
        "receipt_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "required": ["owner_id", "token", "acquired_at", "expires_at"],
      "properties": {
        "owner_id": { "type": "string", "minLength": 1 },
        "token": { "type": "string", "minLength": 1 },
        "acquired_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
