{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.make-slide-pro/schemas/canonical-content.schema.json",
  "title": "Make Slide Pro Canonical Content",
  "type": "object",
  "required": ["schema_version", "status", "atoms"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "enum": ["PASS", "UNVERIFIED", "BLOCKED"] },
    "atoms": { "type": "array", "minItems": 1, "items": { "$ref": "content-atom.schema.json" } },
    "source_manifest_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "unresolved_conflicts": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
