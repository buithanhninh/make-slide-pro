{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.make-slide-pro/schemas/data-ledger.schema.json",
  "title": "Data Ledger",
  "type": "object",
  "required": ["schema_version", "metrics"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_id", "metric_key", "value", "unit", "period", "denominator", "source_id", "locator", "verification_status", "actual_or_forecast"],
        "properties": {
          "metric_id": { "type": "string", "minLength": 1 },
          "metric_key": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "string"] },
          "unit": { "type": "string", "minLength": 1 },
          "period": { "type": "string", "minLength": 1 },
          "denominator": { "type": ["string", "null"], "minLength": 1 },
          "formula": { "type": ["string", "null"], "minLength": 1 },
          "formula_inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "source_id": { "type": "string", "minLength": 1 },
          "locator": { "type": "object", "minProperties": 1 },
          "verification_status": { "enum": ["VERIFIED", "REVIEW_REQUIRED", "UNVERIFIED", "CONFLICTED"] },
          "actual_or_forecast": { "enum": ["ACTUAL", "FORECAST", "TARGET", "ASSUMPTION", "UNKNOWN"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
