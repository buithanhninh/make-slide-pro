{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.make-slide-pro/schemas/native-layout-report.schema.json",
  "title": "Make Slide Pro Native Layout Report",
  "type": "object",
  "required": ["schema_version", "generated_at", "deck_path", "status", "findings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "deck_path": { "type": "string", "minLength": 1 },
    "deck_sha256": { "$ref": "#/$defs/sha256" },
    "deck_sha256_before": { "$ref": "#/$defs/sha256" },
    "deck_sha256_after": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["PASS", "UNVERIFIED", "BLOCKED"] },
    "slide_count": { "type": "integer", "minimum": 1 },
    "slide_size_points": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "findings": { "type": "array", "items": { "$ref": "qa-finding.schema.json" } },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    },
    "error": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": {
        "required": [
          "deck_sha256",
          "deck_sha256_before",
          "deck_sha256_after",
          "slide_count",
          "slide_size_points",
          "slides"
        ],
        "properties": {
          "findings": {
            "items": {
              "properties": { "severity": { "not": { "enum": ["P0", "P1"] } } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "slide": {
      "type": "object",
      "required": ["slide", "shape_count", "objects"],
      "properties": {
        "slide": { "type": "integer", "minimum": 1 },
        "shape_count": { "type": "integer", "minimum": 0 },
        "objects": {
          "type": "array",
          "items": { "$ref": "#/$defs/object" }
        }
      },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "integer" },
        "left": { "type": "number" },
        "top": { "type": "number" },
        "right": { "type": "number" },
        "bottom": { "type": "number" },
        "bounds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "has_text": { "type": "boolean" },
        "is_table": { "type": "boolean" },
        "is_chart": { "type": "boolean" },
        "text": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
