{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.make-slide-pro/schemas/claim-ledger.schema.json",
  "title": "Claim Ledger",
  "type": "object",
  "required": ["schema_version", "claims"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "claims": { "type": "array", "items": { "type": "object", "required": ["claim_id", "text", "source_atoms", "confidence", "status"], "properties": { "claim_id": { "type": "string" }, "text": { "type": "string", "minLength": 1 }, "source_atoms": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "confidence": { "enum": ["VERIFIED", "REVIEW_REQUIRED", "UNVERIFIED", "CONFLICTED"] }, "status": { "enum": ["APPROVED", "REVIEW_REQUIRED", "REJECTED"] }, "derived_logic": { "type": ["string", "null"] } } } }
  },
  "additionalProperties": false
}
