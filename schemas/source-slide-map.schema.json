{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.make-slide-pro/schemas/source-slide-map.schema.json",
  "title": "Make Slide Pro Source Slide Map",
  "type": "object",
  "required": ["schema_version", "mappings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id", "slide_number", "atom_ids", "claim_ids", "metric_ids", "asset_ids"],
        "properties": {
          "slide_id": { "type": "string" },
          "slide_number": { "type": "integer", "minimum": 1 },
          "atom_ids": { "type": "array", "items": { "type": "string" } },
          "claim_ids": { "type": "array", "items": { "type": "string" } },
          "metric_ids": { "type": "array", "items": { "type": "string" } },
          "asset_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
