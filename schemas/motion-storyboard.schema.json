{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.make-slide-pro/schemas/motion-storyboard.schema.json",
  "title": "Make Slide Pro Motion Storyboard",
  "type": "object",
  "required": ["schema_version", "click_controlled", "auto_advance_allowed", "replace_existing", "slides"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "click_controlled": { "const": true },
    "auto_advance_allowed": { "const": false },
    "replace_existing": { "const": true },
    "max_effects_per_slide": { "type": "integer", "minimum": 1, "maximum": 100 },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide", "transition", "beats"],
        "properties": {
          "slide": { "type": "integer", "minimum": 1 },
          "transition": { "enum": ["none", "fade_smoothly", "morph"] },
          "beats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["shape_names", "effect", "trigger", "duration", "delay", "narrative_purpose"],
              "properties": {
                "shape_names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "effect": { "enum": ["appear", "fade", "wipe", "grow"] },
                "trigger": { "enum": ["on_click", "with_previous", "after_previous"] },
                "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
                "delay": { "type": "number", "minimum": 0, "maximum": 10 },
                "narrative_purpose": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
