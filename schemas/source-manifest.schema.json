{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.make-slide-pro/schemas/source-manifest.schema.json",
  "title": "Make Slide Pro Source Manifest",
  "type": "object",
  "required": ["schema_version", "generated_at", "input_root", "source_count", "status", "blocking_reasons", "errors", "sources"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "input_root": { "type": "string", "minLength": 1 },
    "source_count": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["PASS", "UNVERIFIED", "BLOCKED"] },
    "blocking_reasons": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "errors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "path", "detected_format", "sha256", "size_bytes", "role", "authority", "risk_flags"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^source-[0-9]{3,}$" },
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "extension": { "type": "string" },
          "detected_format": { "type": "string", "minLength": 1 },
          "extension_mismatch": { "type": "boolean" },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "modified_at": { "type": "string", "format": "date-time" },
          "role": { "enum": ["PRIMARY_CONTENT", "DATA_AUTHORITY", "BRAND_GUIDELINE", "TEMPLATE", "VISUAL_REFERENCE", "MEDIA_ASSET", "SUPPORTING_EVIDENCE", "PREVIOUS_DECK", "EXCLUDED"] },
          "authority": { "type": "string", "minLength": 1 },
          "risk_flags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "error": { "type": ["string", "null"], "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": {
        "properties": {
          "sources": { "minItems": 1 },
          "source_count": { "minimum": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
