{
  "schema_version": "1.0",
  "default_family": "lucide",
  "default_stroke_width": 1.75,
  "default_size_px": 24,
  "semantic_registry": {
    "strategy": "Target",
    "growth": "TrendingUp",
    "risk": "ShieldAlert",
    "decision": "BadgeCheck",
    "action": "ArrowRight",
    "timeline": "CalendarRange",
    "market": "Globe2",
    "customer": "UsersRound",
    "product": "PackageOpen",
    "operations": "Workflow",
    "finance": "ChartNoAxesCombined",
    "data": "Database",
    "insight": "Lightbulb",
    "problem": "CircleAlert",
    "evidence": "FileCheck2",
    "quality": "ScanSearch",
    "location": "MapPinned",
    "people": "UserRound",
    "time": "Clock3",
    "check": "Check",
    "close": "X",
    "menu": "Menu",
    "filter": "ListFilter",
    "external": "ExternalLink"
  },
  "icons": {
    "Target": "goal or strategic focus",
    "TrendingUp": "growth or positive trajectory",
    "ShieldAlert": "risk requiring attention",
    "BadgeCheck": "validated decision or quality gate",
    "ArrowRight": "action or directional flow",
    "CalendarRange": "time window or roadmap",
    "Globe2": "market or geography",
    "UsersRound": "customer or audience group",
    "PackageOpen": "product or offer",
    "Workflow": "operating model or process",
    "ChartNoAxesCombined": "financial or performance metric",
    "Database": "data source or system",
    "Lightbulb": "insight or implication",
    "CircleAlert": "problem or exception",
    "FileCheck2": "evidence or source validation",
    "ScanSearch": "review or audit",
    "MapPinned": "location or route",
    "UserRound": "single person or owner",
    "Clock3": "timing or cadence",
    "Check": "completed state",
    "X": "blocked or removed state",
    "Menu": "navigation",
    "ListFilter": "filtering or segmentation",
    "ExternalLink": "external reference"
  },
  "usage_rules": {
    "family_is_singleton": true,
    "use_vector_paths": true,
    "do_not_use_unicode_emoji": true,
    "do_not_mix_filled_icon_sets": true,
    "size_scale_px": [16, 20, 24, 32, 40]
  }
}
