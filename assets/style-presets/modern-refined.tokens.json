{
  "schema_version": "1.0",
  "preset_id": "MODERN_REFINED",
  "description": "Presentation token preset for calm, high-contrast, premium business storytelling.",
  "canvas": {
    "width": 1280,
    "height": 720,
    "safe_inset": 56,
    "grid_unit": 8
  },
  "colors": {
    "base": "#F4F7FB",
    "surface": "#FFFFFF",
    "ink": "#102033",
    "muted": "#53677D",
    "line": "#D9E3EE",
    "brand": "#D71920",
    "brand_deep": "#A80F17",
    "accent": "#22C7E8",
    "accent_deep": "#087C9A",
    "navy": "#07172E",
    "navy_surface": "#0D2746",
    "success": "#198754",
    "warning": "#B26A00",
    "danger": "#B42318",
    "info": "#175CD3",
    "white": "#FFFFFF",
    "black": "#020617"
  },
  "typography": {
    "primary_family": "Segoe UI",
    "numeric_family": "Bahnschrift",
    "fallback_families": ["Arial", "Aptos"],
    "title_pt": 32,
    "section_pt": 26,
    "body_pt": 18,
    "small_pt": 12,
    "minimum_body_pt": 16,
    "minimum_title_pt": 28,
    "artifact_tool_px_per_pt": 1.3333333333,
    "title_weight": 700,
    "body_weight": 400,
    "line_height": 1.18,
    "letter_spacing": 0
  },
  "spacing": {
    "xs": 8,
    "sm": 16,
    "md": 24,
    "lg": 32,
    "xl": 48,
    "xxl": 64
