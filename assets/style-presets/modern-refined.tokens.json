  "radii": {
    "small": 8,
    "medium": 16,
    "large": 24,
    "pill": 999
  },
  "shadows": {
    "none": "shadow-none",
    "subtle": "shadow-sm",
    "maximum_levels": 2
  },
  "charts": {
    "categorical": ["#D71920", "#22C7E8", "#07172E", "#7C4DFF", "#198754", "#B26A00"],
    "sequential": ["#E8F3FB", "#A7DFF0", "#22C7E8", "#087C9A", "#07172E"],
    "positive": "#198754",
    "negative": "#B42318",
    "neutral": "#7B8DA2",
    "gridline": "#D9E3EE",
    "label": "#53677D"
  },
  "image_policy": {
    "minimum_effective_ppi": 150,
    "hero_minimum_effective_ppi": 180,
